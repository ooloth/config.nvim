#!/usr/bin/env bash
# Prepares a fresh Amp orb (Debian 12) to run this config and its checks (see CONTRIBUTING.md):
# `stylua --check .` and the headless tests in tests/, which load plugins that lazy.nvim installed
# for NVIM_APPNAME=nvim-ide. Safe to rerun: each step skips work that is already done.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo}"

NEOVIM_VERSION="0.12.6"
STYLUA_VERSION="2.6.0"
TREE_SITTER_VERSION="0.27.1"
LAZYGIT_VERSION="0.66.2"
YAZI_VERSION="26.9.1"
NERD_FONTS_VERSION="3.5.1"

step() {
  local name="$1" start=${SECONDS}
  shift
  printf '\n== %s\n' "${name}"
  "$@"
  printf '== %s took %ds\n' "${name}" $((SECONDS - start))
}

# Debian's neovim is 0.7, too old for vim.lsp.config, so use the release tarball
install_neovim() {
  if [[ "$(nvim --version 2>/dev/null | head -1)" == "NVIM v${NEOVIM_VERSION}" ]]; then
    echo "neovim ${NEOVIM_VERSION} already installed"
    return
  fi
  local tmp
  tmp="$(mktemp -d)"
  curl -fsSL "https://github.com/neovim/neovim/releases/download/v${NEOVIM_VERSION}/nvim-linux-x86_64.tar.gz" |
    tar -xz -C "${tmp}"
  sudo rm -rf /opt/nvim
  sudo mv "${tmp}/nvim-linux-x86_64" /opt/nvim
  sudo ln -sfn /opt/nvim/bin/nvim /usr/local/bin/nvim
  rm -rf "${tmp}"
}

install_stylua() {
  if [[ "$(stylua --version 2>/dev/null)" == "stylua ${STYLUA_VERSION}" ]]; then
    echo "stylua ${STYLUA_VERSION} already installed"
    return
  fi
  local tmp
  tmp="$(mktemp -d)"
  curl -fsSL -o "${tmp}/stylua.zip" \
    "https://github.com/JohnnyMorganz/StyLua/releases/download/v${STYLUA_VERSION}/stylua-linux-x86_64.zip"
  unzip -q "${tmp}/stylua.zip" -d "${tmp}"
  sudo install -m 0755 "${tmp}/stylua" /usr/local/bin/stylua
  rm -rf "${tmp}"
}

# ts-install.nvim (auto_install) compiles a missing parser with the tree-sitter CLI when a buffer
# opens. The release binary warns that it wants GLIBC_2.39 (Debian 12 has 2.36) but builds parsers.
install_tree_sitter() {
  if [[ "$(tree-sitter --version 2>/dev/null)" == "tree-sitter ${TREE_SITTER_VERSION}" ]]; then
    echo "tree-sitter ${TREE_SITTER_VERSION} already installed"
    return
  fi
  local tmp
  tmp="$(mktemp -d)"
  curl -fsSL -o "${tmp}/tree-sitter.zip" \
    "https://github.com/tree-sitter/tree-sitter/releases/download/v${TREE_SITTER_VERSION}/tree-sitter-cli-linux-x64.zip"
  unzip -q "${tmp}/tree-sitter.zip" -d "${tmp}"
  sudo install -m 0755 "${tmp}/tree-sitter" /usr/local/bin/tree-sitter
  rm -rf "${tmp}"
}

# snacks.nvim's lazygit popup and yazi.nvim run these when opened, so neither works without them
install_lazygit() {
  if [[ "$(lazygit --version 2>/dev/null)" == *"version=${LAZYGIT_VERSION},"* ]]; then
    echo "lazygit ${LAZYGIT_VERSION} already installed"
    return
  fi
  local tmp
  tmp="$(mktemp -d)"
  curl -fsSL "https://github.com/jesseduffield/lazygit/releases/download/v${LAZYGIT_VERSION}/lazygit_${LAZYGIT_VERSION}_linux_x86_64.tar.gz" |
    tar -xz -C "${tmp}" lazygit
  sudo install -m 0755 "${tmp}/lazygit" /usr/local/bin/lazygit
  rm -rf "${tmp}"
}

# The musl build, so it doesn't depend on Debian 12's glibc version
install_yazi() {
  if [[ "$(yazi --version 2>/dev/null)" == *"Version: ${YAZI_VERSION} "* ]]; then
    echo "yazi ${YAZI_VERSION} already installed"
    return
  fi
  local tmp name="yazi-x86_64-unknown-linux-musl"
  tmp="$(mktemp -d)"
  curl -fsSL -o "${tmp}/yazi.zip" "https://github.com/sxyazi/yazi/releases/download/v${YAZI_VERSION}/${name}.zip"
  unzip -q "${tmp}/yazi.zip" -d "${tmp}"
  sudo install -m 0755 "${tmp}/${name}/yazi" "${tmp}/${name}/ya" /usr/local/bin/
  rm -rf "${tmp}"
}

# The config's icons come from a Nerd Font, which a terminal in the Desktop tab needs to draw them.
# Fontconfig falls back to this symbols-only font for those glyphs.
install_nerd_font() {
  local dir="${HOME}/.local/share/fonts/nerd-fonts-symbols-${NERD_FONTS_VERSION}"
  if [[ -d "${dir}" ]]; then
    echo "Nerd Font symbols ${NERD_FONTS_VERSION} already installed"
    return
  fi
  local tmp
  tmp="$(mktemp -d)"
  curl -fsSL "https://github.com/ryanoasis/nerd-fonts/releases/download/v${NERD_FONTS_VERSION}/NerdFontsSymbolsOnly.tar.xz" |
    tar -xJ -C "${tmp}"
  rm -rf "${HOME}"/.local/share/fonts/nerd-fonts-symbols-*
  mkdir -p "$(dirname "${dir}")"
  mv "${tmp}" "${dir}"
  fc-cache -f "${dir}"
}

# The nvim-ide entry point loads this repo from ~/Repos/ooloth/config.nvim, and
# util.require_all_files_in_config_directory reads lang files from that path too
link_checkout() {
  local link="${HOME}/Repos/ooloth/config.nvim"
  if [[ ! -e "${link}" ]]; then
    mkdir -p "$(dirname "${link}")"
    ln -s "${repo}" "${link}"
  fi
  echo "${link} -> $(readlink -f "${link}")"
}

# The entry point (init.lua) and plugin lockfile live in the dotfiles repo, which symlinks them into
# ~/.config/nvim-ide on a Mac. Copies, not links, so lazy.nvim rewriting the lockfile here never
# leaves the dotfiles clone dirty. Each setup run refreshes them from dotfiles' main branch.
install_entry_point() {
  local src="https://raw.githubusercontent.com/ooloth/dotfiles/main/tools/neovim/config/nvim-ide"
  local dest="${HOME}/.config/nvim-ide" file
  mkdir -p "${dest}"
  for file in init.lua lazy-lock.json; do
    curl -fsSL -o "${dest}/${file}.tmp" "${src}/${file}"
    mv "${dest}/${file}.tmp" "${dest}/${file}"
  done
  echo "copied init.lua and lazy-lock.json to ${dest}"
}

# Install every plugin at the commit lazy-lock.json pins, so the tests find them in
# ~/.local/share/nvim-ide/lazy/. Warm runs only confirm the checkouts. Neovim exits 0 when a clone
# or build fails, so this exits 1 itself when a plugin is missing or any of its tasks failed.
# Headless lazy.nvim streams a command's output instead of recording a failed exit as an error, so
# the script turns that off and reruns every plugin's build step, which startup ran unchecked.
install_plugins() {
  local tmp
  tmp="$(mktemp -d)"
  cat >"${tmp}/restore.lua" <<'LUA'
local lazy = require('lazy')
require('lazy.core.config').options.headless.process = false
lazy.restore({ wait = true, show = false })
local built = vim.tbl_filter(function(plugin) return plugin.build ~= nil end, lazy.plugins())
if #built > 0 then lazy.build({ wait = true, show = false, plugins = built }) end
local failed = 0
for _, plugin in ipairs(lazy.plugins()) do
  if not plugin._.installed then
    failed = failed + 1
    io.stderr:write('\nnot installed: ' .. plugin.name)
  end
  for _, task in ipairs(plugin._.tasks or {}) do
    if task:has_errors() then
      failed = failed + 1
      io.stderr:write('\n' .. plugin.name .. ' ' .. task.name .. ' failed:\n' .. task:output(vim.log.levels.ERROR))
    end
  end
end
io.stderr:write('\n')
vim.cmd(failed > 0 and 'cquit 1' or 'qall')
LUA
  NVIM_APPNAME=nvim-ide nvim --headless -c "luafile ${tmp}/restore.lua"
  rm -rf "${tmp}"
}

step "neovim" install_neovim
step "stylua" install_stylua
step "tree-sitter" install_tree_sitter
step "lazygit" install_lazygit
step "yazi" install_yazi
step "nerd font" install_nerd_font
step "checkout link" link_checkout
step "nvim-ide entry point" install_entry_point
step "plugins" install_plugins
